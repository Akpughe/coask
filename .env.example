# Server Configuration
NODE_ENV=development
PORT=3000

# Database
DATABASE_URL=postgresql://localhost:5432/coask
REDIS_URL=redis://localhost:6379

# LLM Providers
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# RAG Pipeline
MISTRAL_API_KEY=...
PINECONE_API_KEY=...

# Web Search
EXA_API_KEY=...

# Email Providers
# At least one email provider is required for sending emails
RESEND_API_KEY=re_...
SENDGRID_API_KEY=SG....
AWS_SES_ACCESS_KEY=AKIA...
AWS_SES_SECRET_KEY=...
AWS_SES_REGION=us-east-1

# Email Domain Routing (Optional)
# Route emails from specific domains to specific providers
# Format: EMAIL_DOMAIN_{domain}_PROVIDER={provider}
# Format: EMAIL_DOMAIN_{domain}_FROM={default_from_address}
# Examples:
# EMAIL_DOMAIN_test.com_PROVIDER=sendgrid
# EMAIL_DOMAIN_test.com_FROM=hello@test.com
# EMAIL_DOMAIN_company.com_PROVIDER=resend
# EMAIL_DOMAIN_company.com_FROM=support@company.com

# Google OAuth (for Gmail integration)
GOOGLE_CLIENT_ID=...
GOOGLE_CLIENT_SECRET=...
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# Security
JWT_SECRET=your-secret-key-change-in-production
ENCRYPTION_KEY=your-encryption-key-change-in-production
